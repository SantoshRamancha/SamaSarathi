{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Postgres": "",
    "Redis": "localhost:6379"
  },
  "Pricing": {
    "NormalSpeedKmph": 25,
    "TrafficRatioThreshold": 1.3,
    "MaxAboveEstimate": 0.5
  },
  "Otp": {
    "ExpiryMinutes": 5,
    "ResendCooldownSeconds": 30,
    "MaxAttempts": 5
  },
  "Jwt": {
    "Key": "",
    "Issuer": "samasarathi",
    "Audience": "samasarathi-apps",
    "LifetimeDays": 30,
    "AdminLifetimeHours": 12
  },
  "Admin": {
    "Phones": []
  },
  "Subscription": {
    "Enabled": true,
    "PlanName": "Monthly",
    "MonthlyPrice": 499,
    "PlanDays": 30,
    "TrialDays": 30,
    "GraceDays": 3,
    "ExpiryWarningDays": 3,
    "PaymentsEnabled": false,
    "ExpiryCheckMinutes": 10
  },
  "Location": {
    "StaleAfterSeconds": 60,
    "NearbyRadiusKm": 3,
    "MaxNearbyDrivers": 20
  },
  "Rides": {
    "OfferTimeoutSeconds": 45
  },
  "Routing": {
    "BaseUrl": "https://router.project-osrm.org",
    "CacheMinutes": 10
  },
  "Weather": {
    "BaseUrl": "https://api.open-meteo.com",
    "RainThresholdMm": 0.2,
    "CacheMinutes": 10
  },
  "PeakHours": {
    "TimeZone": "Asia/Kolkata",
    "Windows": [ "08:00-11:00", "17:00-21:00" ],
    "WeekdaysOnly": true
  },
  "Traffic": {
    "PeakSlowdown": 1.5,
    "RainSlowdown": 1.3
  },
  "PlaceSearch": {
    "UserAgent": "Samasarathi/0.1 (development; replace with a contact email)",
    "CountryCodes": "in",
    "MaxResults": 5
  },
  "Storage": {
    "LocalPath": "uploads"
  },
  "AllowedHosts": "*"
}
